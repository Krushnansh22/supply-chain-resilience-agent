# ==============================================================
# backend/.env.example
# Copy to backend/.env and fill in. NEVER commit the real .env (see .gitignore).
# ==============================================================

# --- Database ---
DATABASE_URL=sqlite:///./data/scda.db

# --- LLM provider: anthropic | openai | gemini ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=REPLACE_ME

# --- Business rule constants (Section 10, official PS: >$50,000 requires approval) ---
AUTONOMOUS_APPROVAL_LIMIT_USD=50000

# --- CORS: allow the frontend dev server ---
CORS_ORIGINS=http://localhost:5173

# --- Misc ---
LOG_LEVEL=INFO
