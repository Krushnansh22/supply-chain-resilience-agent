# ============================================================
# backend/.env.example
# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit real secrets.
# ============================================================

# --- MongoDB Atlas ---
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=supply_chain_db

# --- LLM ---
LLM_PROVIDER=anthropic        # anthropic | openai | gemini
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=your-llm-api-key-here

# --- Business Rules ---
AUTONOMOUS_APPROVAL_LIMIT_USD=50000.0

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# For local dev: http://localhost:5173
# For production: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173

# Comma-separated list of allowed HTTP methods.
CORS_ALLOWED_METHODS=GET,POST,OPTIONS

# --- Security ---
# Optional API key for protecting mutating endpoints.
# Leave EMPTY for open access (local dev / hackathon demo mode).
# Set to a long random string for production deployments.
# When set, all POST endpoints require: X-API-Key: <your-key>
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Controls whether interactive Swagger UI /docs and openapi.json are publicly accessible (true/false)
DOCS_ENABLED=true

# --- Rate Limiting & Proxy Configuration ---
# Comma-separated list of trusted reverse proxy IPs (e.g. 127.0.0.1, 10.0.0.1).
# Empty by default (X-Forwarded-For will NOT be trusted unless proxy IP matches).
TRUSTED_PROXY_IPS=

# General rate limit across all endpoints per IP (requests per window)
GENERAL_RATE_LIMIT_MAX=60
GENERAL_RATE_LIMIT_WINDOW=60

# --- Logging ---
LOG_LEVEL=INFO
