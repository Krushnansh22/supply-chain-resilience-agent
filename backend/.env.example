# ==============================================================================
# backend/.env.example — Supply Chain Resilience Agent
# Environment configuration for the backend service and n8n workflow.
# Copy to backend/.env and fill in real values before running docker compose up.
# ==============================================================================

# ------------------------------------------------------------------------------
# FastAPI Backend
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# URL n8n uses to reach the backend inside the Docker network.
BACKEND_URL=http://backend:8000

# Shared secret: set the same value in n8n env + backend env.
BACKEND_API_KEY=changeme-generate-a-strong-random-secret

# ------------------------------------------------------------------------------
# MongoDB Atlas
# ------------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB_NAME=supplychaindb

# ------------------------------------------------------------------------------
# Business Logic
# ------------------------------------------------------------------------------
# Recovery plans costing MORE than this threshold require human approval.
AUTONOMOUS_APPROVAL_LIMIT_USD=50000

# ------------------------------------------------------------------------------
# Email Notifications (SMTP — also configure the SMTP credential in n8n UI)
# ------------------------------------------------------------------------------
NOTIFY_FROM_EMAIL=noreply@yourdomain.com
APPROVAL_NOTIFY_EMAIL=procurement@yourdomain.com
OPS_ALERT_EMAIL=ops-team@yourdomain.com

# ------------------------------------------------------------------------------
# Groq AI — Post-Analysis LLM Layer
# ------------------------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1

# ------------------------------------------------------------------------------
# n8n Workflow Engine
# ------------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=changeme-generate-a-32-byte-hex-key
N8N_USER_FOLDER=/home/node/.n8n
N8N_BASE_URL=http://n8n:5678

# ------------------------------------------------------------------------------
# CORS & Security
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,OPTIONS
DOCS_ENABLED=true
TRUSTED_PROXY_IPS=
GENERAL_RATE_LIMIT_MAX=60
GENERAL_RATE_LIMIT_WINDOW=60
LOG_LEVEL=INFO
