# ============================================================
# backend/.env.example
# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit real secrets.
# ============================================================

# --- Database ---
DATABASE_URL=sqlite:///./data/scda.db

# --- LLM ---
LLM_PROVIDER=anthropic        # anthropic | openai | gemini
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=your-llm-api-key-here

# --- Business Rules ---
AUTONOMOUS_APPROVAL_LIMIT_USD=50000.0

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# For local dev: http://localhost:5173
# For production: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173

# Comma-separated list of allowed HTTP methods.
CORS_ALLOWED_METHODS=GET,POST,OPTIONS

# --- Security ---
# Optional API key for protecting mutating endpoints.
# Leave EMPTY for open access (local dev / hackathon demo mode).
# Set to a long random string for production deployments.
# When set, all POST endpoints require: X-API-Key: <your-key>
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- Logging ---
LOG_LEVEL=INFO
